/* ==========================================================================
   HIDDEN SUGAR DETECTIVE (САХАРНЫЙ ДЕТЕКТИВ)
   Modern 16:9 EdTech Presentation CSS Design System
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. CSS Custom Properties & Design Tokens
   -------------------------------------------------------------------------- */
:root {
  /* Slate Dark Surfaces */
  --bg-app: #0F172A;              /* Slate 900: base backdrop */
  --bg-surface: #1E293B;          /* Slate 800: cards, dialogs, drawers */
  --bg-surface-elevated: #334155; /* Slate 700: elevated hover states */
  --bg-surface-inset: #0F172A;    /* Slate 900: input backgrounds, containers */
  --bg-surface-overlay: rgba(15, 23, 42, 0.85);

  /* Borders & Dividers */
  --border-subtle: #334155;       /* Slate 700 */
  --border-medium: #475569;       /* Slate 600 */
  --border-focus: #38BDF8;        /* Sky 400 */
  --border-gold: #F59E0B;         /* Amber 500 */

  /* Text Colors */
  --text-primary: #F8FAFC;        /* Slate 50: high contrast headings */
  --text-secondary: #CBD5E1;      /* Slate 300: descriptions, body */
  --text-muted: #94A3B8;          /* Slate 400: captions, secondary tags */
  --text-disabled: #64748B;       /* Slate 500: inactive */
  --text-inverse: #0F172A;        /* Slate 900: for light badges */

  /* Level Color Accents */
  --accent-level-1: #2563EB;      /* Royal Blue (Уровень 1: Напитки) */
  --accent-level-2: #7C3AED;      /* Violet (Уровень 2: Завтраки) */
  --accent-level-3: #10B981;      /* Emerald (Уровень 3: Перекусы) */
  --accent-level-4: #F59E0B;      /* Amber (Уровень 4: Соусы) */
  --accent-level-5: #0D9488;      /* Teal (Уровень 5: Консервы) */
  --accent-level-6: #EF4444;      /* Crimson / Rose (Уровень 6: Молочка) */
  --accent-level-7: #06B6D4;      /* Cyan / Ice (Уровень 7: Заморозка) */

  /* System Accents */
  --color-gold: #F59E0B;
  --color-gold-glow: rgba(245, 158, 11, 0.45);
  --color-gold-light: #FDE047;
  --color-success: #10B981;
  --color-success-bg: rgba(16, 185, 129, 0.15);
  --color-danger: #EF4444;
  --color-danger-bg: rgba(239, 68, 68, 0.15);
  --color-info: #38BDF8;
  --color-warning: #F59E0B;

  /* Nutrition Label Simulation */
  --label-bg: #FFFFFF;
  --label-text: #0F172A;
  --label-border: #1E293B;
  --label-sugar-badge: #FEE2E2;
  --label-sugar-text: #B91C1C;

  /* Fonts */
  --font-ui: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', sans-serif;
  --font-code: 'Consolas', 'Monaco', 'Courier New', monospace;

  /* Elevation Shadows */
  --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.2);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.5);
  --shadow-glow-gold: 0 0 16px rgba(245, 158, 11, 0.4);
  --shadow-glow-blue: 0 0 16px rgba(37, 99, 235, 0.4);
  --shadow-glow-cyan: 0 0 16px rgba(6, 182, 212, 0.4);

  /* Transitions */
  --transition-fast: 0.15s ease;
  --transition-normal: 0.25s ease;
  --transition-bounce: 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);

  /* Dynamic Active Level Accent */
  --level-accent: var(--accent-level-1);
}

/* --------------------------------------------------------------------------
   2. Reset & Base Layout
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #0B1120;
  background-image: 
    radial-gradient(circle at 50% 0%, rgba(37, 99, 235, 0.15) 0%, transparent 60%),
    radial-gradient(circle at 80% 100%, rgba(124, 58, 237, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 10% 90%, rgba(6, 182, 212, 0.1) 0%, transparent 40%);
  color: var(--text-primary);
  font-family: var(--font-ui);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  user-select: none;
}

/* App Wrapper: centers 16:9 stage with letterbox/pillarbox */
#app {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

/* --------------------------------------------------------------------------
   3. 16:9 Widescreen Stage Container
   -------------------------------------------------------------------------- */
.stage-container {
  width: 100%;
  height: 100%;
  max-width: 100vw;
  max-height: 100vh;
  aspect-ratio: 16 / 9;
  position: relative;
  background-color: var(--bg-app);
  box-shadow: var(--shadow-lg), 0 0 40px rgba(0, 0, 0, 0.8);
  border: 1px solid var(--border-subtle);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Fallback responsive scaling when screen height or ratio is constrained */
@media (max-aspect-ratio: 16/9) {
  .stage-container {
    width: 100vw;
    height: 56.25vw; /* 100 * 9 / 16 */
    max-height: 100vh;
  }
}

@media (min-aspect-ratio: 16/9) {
  .stage-container {
    height: 100vh;
    width: 177.78vh; /* 100 * 16 / 9 */
    max-width: 100vw;
  }
}

/* Mobile & Portrait single-column feed orientation */
@media (max-width: 860px), (max-aspect-ratio: 1/1) {
  html, body {
    overflow-y: auto;
  }
  #app {
    align-items: flex-start;
    overflow-y: auto;
  }
  .stage-container {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    border: none;
    border-radius: 0;
    box-shadow: none;
  }
  .screen {
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
}

@media (max-width: 480px) {
  .screen-header {
    padding: 10px 14px;
  }
  .screen-header-title {
    font-size: 15px;
  }
  .game-hud {
    padding: 8px 12px;
    gap: 8px;
  }
  .hud-level-title {
    font-size: 13px;
    gap: 6px;
  }
  .hud-progress-bar {
    max-width: 90px;
    height: 6px;
  }
  .hud-heart {
    width: 22px;
    height: 22px;
  }
  .hud-coins-pill {
    padding: 3px 8px;
  }
  .hud-coins-value {
    font-size: 12px;
  }
  .mode-compare-grid {
    grid-template-columns: 1fr;
  }
  .compare-product-card {
    flex-direction: row;
    align-items: center;
    text-align: left;
    gap: 12px;
    padding: 10px 14px;
  }
  .compare-card-svg {
    width: 54px;
    height: 54px;
    min-width: 54px;
    min-height: 54px;
  }
}

/* --------------------------------------------------------------------------
   4. Screen Architecture & State Management
   -------------------------------------------------------------------------- */
.screen {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
  background-color: var(--bg-app);
  z-index: 10;
  opacity: 0;
  transform: scale(0.98);
  transition: opacity var(--transition-normal), transform var(--transition-normal);
  overflow: hidden;
}

.screen.active {
  display: flex;
  opacity: 1;
  transform: scale(1);
  z-index: 20;
}

/* --------------------------------------------------------------------------
   5. Interactive Buttons & Controls
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  font-family: var(--font-ui);
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
  background-color: var(--bg-surface-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  cursor: pointer;
  outline: none;
  position: relative;
  transition: transform var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
  box-shadow: 0 4px 0 rgba(0, 0, 0, 0.4);
}

.btn:hover {
  transform: translateY(-2px);
  background-color: #3B4B64;
  box-shadow: 0 6px 0 rgba(0, 0, 0, 0.4);
}

.btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 0 rgba(0, 0, 0, 0.4);
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB, #1D4ED8);
  border-color: #3B82F6;
  box-shadow: 0 4px 0 #1E3A8A;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  box-shadow: 0 6px 0 #1E3A8A, var(--shadow-glow-blue);
}

.btn-primary:active {
  box-shadow: 0 2px 0 #1E3A8A;
}

.btn-gold {
  background: linear-gradient(135deg, #F59E0B, #D97706);
  color: #0F172A;
  border-color: #FCD34D;
  box-shadow: 0 4px 0 #92400E;
}

.btn-gold:hover {
  background: linear-gradient(135deg, #FBBF24, #F59E0B);
  box-shadow: 0 6px 0 #92400E, var(--shadow-glow-gold);
}

.btn-gold:active {
  box-shadow: 0 2px 0 #92400E;
}

.btn-success {
  background: linear-gradient(135deg, #10B981, #059669);
  border-color: #34D399;
  box-shadow: 0 4px 0 #065F46;
}

.btn-danger {
  background: linear-gradient(135deg, #EF4444, #DC2626);
  border-color: #F87171;
  box-shadow: 0 4px 0 #991B1B;
}

.btn-icon {
  width: 40px;
  height: 40px;
  padding: 0;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.btn-lg {
  padding: 14px 32px;
  font-size: 18px;
  border-radius: 12px;
  box-shadow: 0 5px 0 rgba(0, 0, 0, 0.4);
}

/* Pulsing Primary Action CTA */
.btn-cta-pulse {
  animation: cta-pulse 2.2s infinite;
}

@keyframes cta-pulse {
  0% {
    box-shadow: 0 4px 0 #1E3A8A, 0 0 0 0 rgba(37, 99, 235, 0.7);
  }
  70% {
    box-shadow: 0 4px 0 #1E3A8A, 0 0 0 16px rgba(37, 99, 235, 0);
  }
  100% {
    box-shadow: 0 4px 0 #1E3A8A, 0 0 0 0 rgba(37, 99, 235, 0);
  }
}

/* --------------------------------------------------------------------------
   6. Badges, Chips & Meta Cards
   -------------------------------------------------------------------------- */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 700;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background-color: var(--bg-surface-elevated);
  color: var(--text-secondary);
  border: 1px solid var(--border-subtle);
}

.badge-blue { background: rgba(37, 99, 235, 0.2); color: #93C5FD; border-color: #2563EB; }
.badge-violet { background: rgba(124, 58, 237, 0.2); color: #C4B5FD; border-color: #7C3AED; }
.badge-emerald { background: rgba(16, 185, 129, 0.2); color: #6EE7B7; border-color: #10B981; }
.badge-amber { background: rgba(245, 158, 11, 0.2); color: #FCD34D; border-color: #F59E0B; }
.badge-rose { background: rgba(239, 68, 68, 0.2); color: #FCA5A5; border-color: #EF4444; }
.badge-cyan { background: rgba(6, 182, 212, 0.2); color: #67E8F9; border-color: #06B6D4; }

/* --------------------------------------------------------------------------
   7. Top Accent Bar & Global Screen Headers
   -------------------------------------------------------------------------- */
.top-accent-bar {
  height: 6px;
  width: 100%;
  background: linear-gradient(90deg, #2563EB, #7C3AED, #10B981, #F59E0B, #EF4444, #06B6D4);
  flex-shrink: 0;
}

.screen-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 24px;
  background-color: var(--bg-surface);
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
  z-index: 15;
}

.screen-header-left, .screen-header-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.screen-header-title {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8px;
}

/* --------------------------------------------------------------------------
   8. SCREEN 1: Hero Start Screen
   -------------------------------------------------------------------------- */
.screen-hero {
  align-items: center;
  justify-content: space-between;
  padding: 0 0 20px 0;
  background: radial-gradient(circle at 50% 35%, #1E293B 0%, #0F172A 70%);
}

.hero-top-nav {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 28px;
}

.hero-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 20px;
  gap: 16px;
  max-width: 900px;
  margin: auto;
}

.hero-badge-tag {
  background: rgba(37, 99, 235, 0.15);
  border: 1px solid rgba(59, 130, 246, 0.4);
  color: #93C5FD;
  padding: 6px 16px;
  border-radius: 20px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1px;
}

.hero-title {
  font-size: clamp(32px, 5vw, 48px);
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.15;
  text-shadow: 0 0 24px rgba(56, 189, 248, 0.4);
  letter-spacing: -0.5px;
}

.hero-title span {
  background: linear-gradient(135deg, #38BDF8, #818CF8, #F472B6);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: clamp(14px, 1.8vw, 17px);
  color: var(--text-secondary);
  max-width: 720px;
  line-height: 1.5;
}

.hero-illustration {
  width: 140px;
  height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4px 0;
  filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.5));
  animation: float-subtle 4s ease-in-out infinite;
}

@keyframes float-subtle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.hero-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 100%;
  max-width: 500px;
  margin-top: 10px;
}

@media (min-width: 860px) {
  .hero-meta-grid {
    grid-template-columns: repeat(4, 1fr);
    max-width: 900px;
  }
}

.hero-meta-card {
  background-color: rgba(30, 41, 59, 0.7);
  border: 1px solid var(--border-subtle);
  border-radius: 10px;
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  backdrop-filter: blur(4px);
}

.hero-meta-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
}

.hero-meta-value {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

/* --------------------------------------------------------------------------
   9. SCREEN 2: Main Hub
   -------------------------------------------------------------------------- */
.screen-hub {
  padding: 0 0 16px 0;
}

.hub-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 16px;
  padding: 16px 20px 24px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
}

.hub-player-profile {
  display: flex;
  align-items: center;
  gap: 16px;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 12px 20px;
  box-shadow: var(--shadow-md);
  width: 100%;
  max-width: 480px;
}

.hub-avatar-box {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  border: 2px solid var(--border-focus);
  overflow: hidden;
  background-color: #0F172A;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hub-player-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
}

.hub-player-name {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
}

.hub-player-rank {
  font-size: 12px;
  font-weight: 700;
  color: var(--color-gold);
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Single-Column Action Feed (Лента действий) */
.hub-action-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  width: 100%;
  max-width: 480px;
}

.hub-tile {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  padding: 14px 18px;
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: center;
  column-gap: 14px;
  row-gap: 3px;
  cursor: pointer;
  position: relative;
  transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
}

.hub-tile::after {
  content: '›';
  font-size: 24px;
  font-weight: 700;
  color: var(--text-muted);
  grid-column: 3;
  grid-row: 1 / span 2;
  justify-self: end;
  transition: transform var(--transition-fast), color var(--transition-fast);
}

.hub-tile:hover {
  transform: translateX(4px);
  border-color: var(--border-focus);
  box-shadow: var(--shadow-md);
  background-color: var(--bg-surface-elevated);
}

.hub-tile:hover::after {
  color: #38BDF8;
}

.hub-tile-icon {
  width: 48px;
  height: 48px;
  grid-column: 1;
  grid-row: 1 / span 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(15, 23, 42, 0.6);
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  font-size: 26px;
  flex-shrink: 0;
}

.hub-tile-title {
  grid-column: 2;
  grid-row: 1;
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  text-align: left;
}

.hub-tile-desc {
  grid-column: 2;
  grid-row: 2;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.35;
  text-align: left;
}

.hub-cta-section {
  display: flex;
  justify-content: center;
  width: 100%;
  max-width: 480px;
  margin-top: 4px;
}

.hub-cta-section .btn {
  width: 100%;
  padding: 16px 20px;
  font-size: 16px;
  justify-content: center;
}

/* --------------------------------------------------------------------------
   10. SCREEN 3: Level Catalog
   -------------------------------------------------------------------------- */
.screen-catalog {
  padding: 0 0 16px 0;
}

.catalog-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 16px 20px 32px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
}

.catalog-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  width: 100%;
}

.catalog-title {
  font-size: 20px;
  font-weight: 800;
  color: var(--text-primary);
}

/* Single-Column Feed (Лента уровней) */
.catalog-grid {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
}

.level-card {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-subtle);
  border-radius: 14px;
  padding: 14px 16px;
  display: grid;
  grid-template-columns: 84px 1fr;
  grid-template-rows: auto auto auto auto;
  column-gap: 16px;
  row-gap: 3px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.level-card:hover {
  transform: translateY(-2px);
  border-color: var(--level-card-color, #38BDF8);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
}

.level-card.completed {
  border-color: var(--color-gold);
  background: linear-gradient(180deg, #1E293B 0%, #172234 100%);
}

.level-card.completed::after {
  content: '★';
  position: absolute;
  top: 10px;
  right: 14px;
  font-size: 16px;
  color: var(--color-gold);
}

.level-card.locked {
  opacity: 0.55;
  filter: grayscale(0.8);
  cursor: not-allowed;
}

.level-card-top {
  grid-column: 1 / -1;
  grid-row: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 6px;
  margin-bottom: 2px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.level-card-top .level-reward-tag {
  margin-right: 16px;
}

.level-number-badge {
  font-size: 11px;
  font-weight: 800;
  padding: 3px 8px;
  border-radius: 6px;
  color: #FFF;
  background-color: var(--level-card-color, #2563EB);
}

.level-reward-tag {
  font-family: var(--font-code);
  font-size: 11px;
  font-weight: 700;
  color: var(--color-gold);
  display: flex;
  align-items: center;
  gap: 3px;
}

/* Icon preview: 2nd child in level card */
.level-card-icon-wrap,
.level-card > div:nth-child(2) {
  grid-column: 1;
  grid-row: 2 / span 3;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 4px !important;
  background-color: rgba(15, 23, 42, 0.5);
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  width: 84px;
  height: 84px;
  align-self: center;
  justify-self: center;
}

.level-card-title {
  grid-column: 2;
  grid-row: 2;
  font-size: 16px;
  font-weight: 800;
  color: var(--text-primary);
  text-align: left;
}

.level-card-desc {
  grid-column: 2;
  grid-row: 3;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.4;
  text-align: left;
}

.level-card-stars {
  grid-column: 2;
  grid-row: 4;
  display: flex;
  gap: 4px;
  align-items: center;
  margin-top: 2px;
}

.level-card-stars svg {
  width: 16px;
  height: 16px;
}

/* --------------------------------------------------------------------------
   11. SCREEN 4: Active Game View (Sticky HUD + Play Area)
   -------------------------------------------------------------------------- */
.screen-game {
  padding: 0;
}

/* Sticky Top HUD */
.game-hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 24px;
  background-color: var(--bg-surface);
  border-bottom: 1px solid var(--border-subtle);
  flex-shrink: 0;
  gap: 16px;
  z-index: 25;
}

.hud-left, .hud-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.hud-level-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hud-level-title {
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8px;
}

.hud-step-counter {
  font-size: 12px;
  font-family: var(--font-code);
  color: var(--text-muted);
}

/* Hearts Lives System */
.hud-hearts-container {
  display: flex;
  align-items: center;
  gap: 6px;
}

.hud-heart {
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--transition-bounce);
}

.hud-heart.danger {
  animation: heart-danger-pulse 0.8s infinite alternate;
}

.hud-heart.shake {
  animation: heart-shake 0.5s ease-in-out;
}

@keyframes heart-danger-pulse {
  0% { transform: scale(1); filter: drop-shadow(0 0 2px #EF4444); }
  100% { transform: scale(1.22); filter: drop-shadow(0 0 8px #EF4444); }
}

@keyframes heart-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-4px) rotate(-6deg); }
  40%, 80% { transform: translateX(4px) rotate(6deg); }
}

/* Coins Pill Counter & Floating Toast */
.hud-coins-pill {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  background-color: #0F172A;
  border: 1px solid var(--border-gold);
  border-radius: 9999px;
  padding: 4px 12px;
}

.hud-coins-value {
  font-family: var(--font-code);
  font-size: 14px;
  font-weight: 800;
  color: var(--color-gold);
}

.floating-coin-badge {
  position: absolute;
  top: -18px;
  right: -6px;
  font-family: var(--font-ui);
  font-size: 13px;
  font-weight: 900;
  color: var(--color-gold-light);
  background-color: #78350F;
  border: 1px solid var(--border-gold);
  border-radius: 12px;
  padding: 2px 7px;
  pointer-events: none;
  animation: float-coin-up 1.4s forwards ease-out;
}

@keyframes float-coin-up {
  0% { opacity: 0; transform: translateY(8px) scale(0.7); }
  25% { opacity: 1; transform: translateY(0) scale(1.15); }
  80% { opacity: 1; transform: translateY(-16px) scale(1); }
  100% { opacity: 0; transform: translateY(-28px) scale(0.9); }
}

/* HUD Progress Segment Bar */
.hud-progress-bar {
  flex: 1;
  max-width: 240px;
  height: 8px;
  background-color: #0F172A;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid var(--border-subtle);
}

.hud-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB, #38BDF8);
  border-radius: 4px;
  transition: width 0.35s ease;
}

/* Central Question Canvas */
.game-canvas {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 14px 16px 85px;
  position: relative;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
}

.question-prompt-banner {
  width: 100%;
  max-width: 520px;
  text-align: center;
  margin-bottom: 12px;
}

.question-text {
  font-size: clamp(16px, 2.2vw, 20px);
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.35;
}

.question-subtext {
  font-size: 13px;
  color: var(--text-muted);
  margin-top: 4px;
}

/* --------------------------------------------------------------------------
   12. Question Interaction Modes (A, B, C, D, E)
   -------------------------------------------------------------------------- */

/* MODE A: Spoons Quiz (Level 1) */
.mode-spoons-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

.product-showcase-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  box-shadow: var(--shadow-md);
  width: 100%;
}

.product-showcase-svg {
  width: 130px;
  height: 130px;
  min-width: 130px;
  min-height: 130px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: visible;
}

.product-svg {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  display: block;
  flex-shrink: 0;
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
  transition: transform 0.25s ease;
}

.product-showcase-svg:hover .product-svg,
.compare-card-svg:hover .product-svg {
  transform: scale(1.05);
}

.product-showcase-title {
  font-size: 17px;
  font-weight: 800;
  text-align: center;
}

.product-showcase-vol {
  font-family: var(--font-code);
  font-size: 12px;
  color: var(--text-muted);
}

.spoons-quiz-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 100%;
}

.spoon-choice-btn {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-subtle);
  border-radius: 14px;
  padding: 18px 20px;
  display: flex;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  box-shadow: var(--shadow-sm);
}

.spoon-choice-btn:hover {
  transform: translateY(-2px);
  border-color: #38BDF8;
  background-color: var(--bg-surface-elevated);
}

.spoon-choice-btn.selected {
  border-color: #F59E0B;
  background-color: rgba(245, 158, 11, 0.12);
}

.spoon-choice-btn.correct {
  border-color: #10B981 !important;
  background-color: rgba(16, 185, 129, 0.2) !important;
}

.spoon-choice-btn.wrong {
  border-color: #EF4444 !important;
  background-color: rgba(239, 68, 68, 0.2) !important;
}

.spoon-count-number {
  font-family: var(--font-code);
  font-size: 24px;
  font-weight: 900;
  color: var(--text-primary);
  min-width: 44px;
}

.spoon-label-text {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-secondary);
}

/* MODE B: Yes/No Composition Analysis (Level 2) */
.mode-composition-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

/* Nutrition Label Sticker Simulation */
.nutrition-label-box {
  background-color: var(--label-bg);
  color: var(--label-text);
  border: 2px solid var(--label-border);
  border-radius: 8px;
  padding: 14px 18px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  font-family: var(--font-code);
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 100%;
}

.nutrition-label-header {
  font-size: 15px;
  font-weight: 900;
  border-bottom: 3px solid var(--label-border);
  padding-bottom: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.nutrition-ingredients-text {
  font-size: 13px;
  line-height: 1.6;
  color: #1E293B;
  word-break: break-word;
}

.sugar-highlight-tag {
  background-color: var(--label-sugar-badge);
  color: var(--label-sugar-text);
  font-weight: bold;
  padding: 2px 5px;
  border-radius: 3px;
  border-bottom: 2px solid #DC2626;
}

.yes-no-actions-row {
  display: flex;
  gap: 12px;
  margin-top: 6px;
  width: 100%;
}

.btn-yes-sugar, .btn-no-sugar {
  flex: 1;
  padding: 14px 18px;
  font-size: 14px;
  font-weight: 800;
  border-radius: 12px;
}

/* MODE C: Select Hidden Sugar Term (Level 3 & 6.1-6.4) */
.mode-select-sugar-layout {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  width: 100%;
  max-width: 500px;
  margin: 0 auto;
}

.chips-cloud-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin: 6px 0;
}

.ingredient-chip {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-subtle);
  border-radius: 9999px;
  padding: 9px 16px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
  outline: none;
}

.ingredient-chip:hover {
  border-color: #38BDF8;
  color: var(--text-primary);
  background-color: var(--bg-surface-elevated);
}

.ingredient-chip.selected {
  border-color: var(--color-gold);
  background-color: rgba(245, 158, 11, 0.18);
  color: #FEF08A;
  box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
}

.ingredient-chip.correct {
  border-color: #10B981 !important;
  background-color: rgba(16, 185, 129, 0.25) !important;
  color: #6EE7B7 !important;
}

.ingredient-chip.wrong {
  border-color: #EF4444 !important;
  background-color: rgba(239, 68, 68, 0.25) !important;
  color: #FCA5A5 !important;
}

/* MODE D: Multi-Select Checkboxes (Level 4 & Level 6.5) - Single Column Feed */
.mode-checkbox-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  max-width: 500px;
  margin: 8px auto;
}

.checkbox-card-item {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-subtle);
  border-radius: 12px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  cursor: pointer;
  transition: all var(--transition-fast);
  width: 100%;
}

.checkbox-card-item:hover {
  border-color: #38BDF8;
  background-color: var(--bg-surface-elevated);
}

.checkbox-card-item.checked {
  border-color: #38BDF8;
  background-color: rgba(56, 189, 248, 0.12);
}

.custom-checkbox-indicator {
  width: 22px;
  height: 22px;
  border: 2px solid var(--border-subtle);
  border-radius: 6px;
  background-color: #0F172A;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all var(--transition-fast);
}

.checkbox-card-item.checked .custom-checkbox-indicator {
  background-color: #38BDF8;
  border-color: #38BDF8;
}

.checkbox-card-item.checked .custom-checkbox-indicator::after {
  content: '✓';
  color: #0F172A;
  font-size: 14px;
  font-weight: 900;
}

.checkbox-card-label {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

/* MODE E: Product Comparison Grid (Level 5 Least & Level 7 Most) */
.mode-compare-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 100%;
  max-width: 500px;
  margin: 8px auto;
}

.compare-product-card {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-subtle);
  border-radius: 12px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  text-align: center;
  transition: all var(--transition-fast);
}

.compare-product-card:hover {
  transform: translateY(-3px);
  border-color: #38BDF8;
  background-color: var(--bg-surface-elevated);
}

.compare-product-card.selected {
  border-color: var(--color-gold);
  box-shadow: 0 0 16px rgba(245, 158, 11, 0.4);
  background-color: rgba(245, 158, 11, 0.1);
}

.compare-product-card.correct {
  border-color: #10B981 !important;
  background-color: rgba(16, 185, 129, 0.2) !important;
}

.compare-product-card.wrong {
  border-color: #EF4444 !important;
  background-color: rgba(239, 68, 68, 0.2) !important;
}

.compare-card-svg {
  width: 90px;
  height: 90px;
  min-width: 90px;
  min-height: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.compare-card-title {
  font-size: 13px;
  font-weight: 800;
  color: var(--text-primary);
}

/* --------------------------------------------------------------------------
   13. Educational Feedback Drawer
   -------------------------------------------------------------------------- */
.feedback-drawer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--bg-surface);
  border-top: 3px solid var(--border-subtle);
  padding: 16px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  z-index: 30;
  transform: translateY(110%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.6);
}

.feedback-drawer.open {
  transform: translateY(0);
}

.feedback-drawer.success {
  border-top-color: #10B981;
  background: linear-gradient(180deg, rgba(16, 185, 129, 0.15) 0%, #1E293B 100%);
}

.feedback-drawer.error {
  border-top-color: #EF4444;
  background: linear-gradient(180deg, rgba(239, 68, 68, 0.15) 0%, #1E293B 100%);
}

.feedback-content {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: 1;
}

.feedback-icon-box {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feedback-drawer.success .feedback-icon-box {
  background-color: rgba(16, 185, 129, 0.2);
  color: #10B981;
}

.feedback-drawer.error .feedback-icon-box {
  background-color: rgba(239, 68, 68, 0.2);
  color: #EF4444;
}

.feedback-text-block {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.feedback-status-title {
  font-size: 16px;
  font-weight: 900;
}

.feedback-drawer.success .feedback-status-title { color: #10B981; }
.feedback-drawer.error .feedback-status-title { color: #EF4444; }

.feedback-explanation {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.45;
}

@media (max-width: 600px) {
  .feedback-drawer {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding: 12px 18px;
  }
  .feedback-content {
    gap: 12px;
  }
  .feedback-icon-box {
    width: 38px;
    height: 38px;
  }
  .feedback-status-title {
    font-size: 15px;
  }
  .feedback-explanation {
    font-size: 12px;
  }
  .drawer-btn-next {
    width: 100%;
    justify-content: center;
    padding: 12px;
  }
}

/* --------------------------------------------------------------------------
   14. SCREEN 5: Victory Screen
   -------------------------------------------------------------------------- */
.screen-victory {
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  background: radial-gradient(circle at 50% 40%, #1E293B 0%, #0F172A 80%);
}

.victory-canvas-confetti {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 5;
}

.victory-content-card {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  max-width: 760px;
}

.victory-trophy-box {
  width: 80px;
  height: 80px;
  filter: drop-shadow(0 0 20px rgba(245, 158, 11, 0.6));
  animation: bounce-subtle 2s infinite ease-in-out;
}

@keyframes bounce-subtle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.victory-title {
  font-size: clamp(26px, 4vw, 36px);
  font-weight: 900;
  color: #FFFFFF;
}

.victory-title span {
  background: linear-gradient(135deg, #F59E0B, #FDE047);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.victory-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
  max-width: 640px;
}

.victory-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  width: 100%;
  max-width: 500px;
  margin: 6px auto;
}

@media (min-width: 860px) {
  .victory-stats-grid {
    grid-template-columns: repeat(4, 1fr);
    max-width: 760px;
  }
}

.victory-stat-item {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 12px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.victory-stat-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
}

.victory-stat-val {
  font-family: var(--font-code);
  font-size: 18px;
  font-weight: 900;
  color: var(--text-primary);
}

.victory-actions-row {
  display: flex;
  gap: 14px;
  margin-top: 10px;
}

/* --------------------------------------------------------------------------
   15. Modal Dialogs & Overlays
   -------------------------------------------------------------------------- */
.modal-backdrop {
  position: absolute;
  inset: 0;
  background-color: var(--bg-surface-overlay);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  transition: opacity var(--transition-normal);
}

.modal-backdrop.open {
  display: flex;
  opacity: 1;
}

.modal-dialog {
  background-color: var(--bg-surface);
  border: 2px solid var(--border-subtle);
  border-radius: 18px;
  width: calc(100% - 48px);
  max-width: 540px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  transform: scale(0.95);
  transition: transform var(--transition-normal);
}

.modal-backdrop.open .modal-dialog {
  transform: scale(1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 12px;
}

.modal-title {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-size: 14px;
  color: var(--text-secondary);
}

.modal-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 14px;
}

/* Game Over Modal Styling */
.game-over-banner {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.game-over-icon {
  width: 56px;
  height: 56px;
  color: #EF4444;
}

/* Settings Sliders & Inputs */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.setting-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.range-slider {
  -webkit-appearance: none;
  width: 160px;
  height: 6px;
  background: #334155;
  border-radius: 3px;
  outline: none;
}

.range-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #38BDF8;
  cursor: pointer;
  box-shadow: 0 0 6px rgba(56, 189, 248, 0.6);
}

.text-input {
  background-color: var(--bg-surface-inset);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  padding: 8px 12px;
  color: var(--text-primary);
  font-family: var(--font-ui);
  font-size: 14px;
  outline: none;
}

.text-input:focus {
  border-color: var(--border-focus);
}

/* Avatar Selector Grid */
.avatar-select-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.avatar-choice-option {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: 2px solid var(--border-subtle);
  cursor: pointer;
  overflow: hidden;
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.avatar-choice-option:hover {
  transform: scale(1.08);
  border-color: #38BDF8;
}

.avatar-choice-option.selected {
  border-color: #F59E0B;
  box-shadow: 0 0 12px rgba(245, 158, 11, 0.5);
}

/* --------------------------------------------------------------------------
   16. Teacher / Auditor Debug Panel (`~`)
   -------------------------------------------------------------------------- */
.debug-panel-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background-color: rgba(15, 23, 42, 0.95);
  border-bottom: 2px solid #F59E0B;
  padding: 12px 20px;
  z-index: 200;
  display: none;
  flex-direction: column;
  gap: 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8);
}

.debug-panel-overlay.open {
  display: flex;
}

.debug-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  font-weight: 800;
  color: #F59E0B;
  font-family: var(--font-code);
}

.debug-btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.btn-debug {
  padding: 4px 10px;
  font-size: 11px;
  font-family: var(--font-code);
  font-weight: 700;
  background-color: #1E293B;
  border: 1px solid #475569;
  color: #F8FAFC;
  border-radius: 4px;
  cursor: pointer;
}

.btn-debug:hover {
  background-color: #334155;
  border-color: #F59E0B;
  color: #FEF08A;
}

/* --------------------------------------------------------------------------
   17. Detective Diploma / Certificate Modal
   -------------------------------------------------------------------------- */
.diploma-modal-dialog {
  max-width: 820px;
  padding: 16px;
  background-color: transparent;
  border: none;
  box-shadow: none;
}

.diploma-svg-wrapper {
  width: 100%;
  max-width: 800px;
  filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.8));
}


/* ==========================================================================
   ENHANCED EXTENSIONS: THEMES, STORE, BOOSTERS, CALCULATOR, MARATHON & BOSS
   ========================================================================== */

/* --------------------------------------------------------------------------
   A. Dynamic UI Themes
   -------------------------------------------------------------------------- */
body[data-theme="theme_cyber"] {
  --bg-app: #083344;
  --bg-surface: #0e3d54;
  --bg-surface-elevated: #155e75;
  --border-subtle: #164e63;
  --border-focus: #22d3ee;
  --color-info: #06b6d4;
  background-image: radial-gradient(circle at 50% 0%, rgba(6, 182, 212, 0.25) 0%, transparent 60%),
                    radial-gradient(circle at 90% 90%, rgba(56, 189, 248, 0.2) 0%, transparent 50%);
}

body[data-theme="theme_eco"] {
  --bg-app: #064E3B;
  --bg-surface: #065F46;
  --bg-surface-elevated: #047857;
  --border-subtle: #065f46;
  --border-focus: #34d399;
  --color-info: #10b981;
  background-image: radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.25) 0%, transparent 60%),
                    radial-gradient(circle at 90% 90%, rgba(52, 211, 153, 0.2) 0%, transparent 50%);
}

body[data-theme="theme_amethyst"] {
  --bg-app: #2E1065;
  --bg-surface: #3B0764;
  --bg-surface-elevated: #581C87;
  --border-subtle: #581c87;
  --border-focus: #c084fc;
  --color-info: #a855f7;
  background-image: radial-gradient(circle at 50% 0%, rgba(168, 85, 247, 0.25) 0%, transparent 60%),
                    radial-gradient(circle at 90% 90%, rgba(216, 180, 254, 0.15) 0%, transparent 50%);
}

body[data-theme="theme_noir"] {
  --bg-app: #1C1917;
  --bg-surface: #292524;
  --bg-surface-elevated: #44403C;
  --border-subtle: #44403c;
  --border-focus: #fbbf24;
  --color-info: #f59e0b;
  background-image: radial-gradient(circle at 50% 0%, rgba(245, 158, 11, 0.2) 0%, transparent 60%),
                    radial-gradient(circle at 90% 90%, rgba(251, 191, 36, 0.15) 0%, transparent 50%);
}

/* --------------------------------------------------------------------------
   B. In-Game Booster Toolbar
   -------------------------------------------------------------------------- */
.in-game-booster-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: 8px;
  padding: 6px 14px;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid var(--border-subtle);
  border-radius: 30px;
  backdrop-filter: blur(8px);
  width: fit-content;
  max-width: 90%;
  margin-left: auto;
  margin-right: auto;
}

.booster-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  border-radius: 20px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all var(--transition-fast);
  user-select: none;
}

.booster-btn:hover:not([disabled]) {
  background: var(--bg-surface-elevated);
  border-color: var(--border-focus);
  transform: translateY(-2px);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

.booster-btn:disabled, .booster-btn.depleted {
  opacity: 0.45;
  cursor: not-allowed;
  filter: grayscale(0.6);
}

.booster-badge-count {
  background: #3B82F6;
  color: #FFF;
  font-size: 11px;
  font-weight: 900;
  padding: 1px 6px;
  border-radius: 10px;
}

.booster-badge-count.zero {
  background: #64748B;
}

.booster-btn.active-shield {
  background: linear-gradient(135deg, #0284C7, #0369A1);
  border-color: #38BDF8;
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
  animation: pulse-shield 2s infinite;
}

@keyframes pulse-shield {
  0%, 100% { box-shadow: 0 0 8px rgba(56, 189, 248, 0.4); }
  50% { box-shadow: 0 0 16px rgba(56, 189, 248, 0.8); }
}

.hud-hearts-container.shield-active {
  position: relative;
  border: 2px solid #38BDF8;
  border-radius: 24px;
  padding: 2px 8px;
  background: rgba(2, 132, 199, 0.25);
  box-shadow: 0 0 14px rgba(56, 189, 248, 0.6);
}

.hud-hearts-container.shield-active::after {
  content: '🛡️ ЩИТ';
  position: absolute;
  top: -12px;
  right: 50%;
  transform: translateX(50%);
  background: #0284C7;
  color: #FFF;
  font-size: 9px;
  font-weight: 900;
  padding: 0 6px;
  border-radius: 8px;
  border: 1px solid #38BDF8;
}

/* --------------------------------------------------------------------------
   C. Boss Battle Interface (Level 15)
   -------------------------------------------------------------------------- */
.boss-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(90deg, rgba(124, 58, 237, 0.4), rgba(225, 29, 72, 0.4));
  border: 2px solid #8B5CF6;
  border-radius: 12px;
  padding: 8px 16px;
  margin-bottom: 8px;
  box-shadow: 0 0 16px rgba(139, 92, 246, 0.4);
}

.boss-title-block {
  display: flex;
  align-items: center;
  gap: 10px;
}

.boss-name {
  font-size: 15px;
  font-weight: 900;
  color: #FDE047;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.boss-hp-slots {
  display: flex;
  gap: 6px;
}

.boss-hp-heart {
  width: 20px;
  height: 20px;
  transition: transform var(--transition-bounce), opacity var(--transition-fast);
}

.boss-hp-heart.empty {
  opacity: 0.2;
  filter: grayscale(1);
  transform: scale(0.85);
}

/* --------------------------------------------------------------------------
   D. Detective Shop Modal
   -------------------------------------------------------------------------- */
.shop-tabs-nav {
  display: flex;
  gap: 6px;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 8px;
  margin-bottom: 14px;
}

.shop-tab-btn {
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 700;
  padding: 6px 14px;
  border-radius: 8px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.shop-tab-btn:hover {
  color: var(--text-primary);
  background: var(--bg-surface-elevated);
}

.shop-tab-btn.active {
  color: #FFF;
  background: var(--accent-level-1);
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.4);
}

.shop-items-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
  max-height: 420px;
  overflow-y: auto;
  padding-right: 4px;
}

.shop-item-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
  transition: all var(--transition-fast);
}

.shop-item-card:hover {
  border-color: var(--border-gold);
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.shop-item-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.shop-item-icon {
  font-size: 28px;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
}

.shop-item-title {
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
}

.shop-item-desc {
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.4;
  flex-grow: 1;
}

.shop-item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
  padding-top: 8px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.shop-price-tag {
  display: flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-code);
  font-size: 14px;
  font-weight: 900;
  color: var(--color-gold-light);
}

.shop-owned-badge {
  font-size: 11px;
  font-weight: 800;
  color: var(--color-success);
  background: var(--color-success-bg);
  padding: 3px 8px;
  border-radius: 6px;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

/* --------------------------------------------------------------------------
   E. Sugar Calculator Interface
   -------------------------------------------------------------------------- */
.calc-quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 10px 0 16px 0;
}

.calc-chip {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  padding: 4px 10px;
  font-size: 12px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.calc-chip:hover {
  border-color: var(--border-focus);
  color: var(--text-primary);
  background: var(--bg-surface-elevated);
}

.calc-chip.active {
  background: var(--accent-level-1);
  color: #FFF;
  border-color: #38BDF8;
}

.calc-results-card {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border-gold);
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  box-shadow: 0 0 16px rgba(245, 158, 11, 0.15);
}

.calc-metrics-row {
  display: flex;
  gap: 16px;
  width: 100%;
  justify-content: space-around;
}

.calc-metric-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.calc-metric-val {
  font-size: 26px;
  font-weight: 900;
  font-family: var(--font-code);
  color: var(--color-gold-light);
}

.calc-metric-label {
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* --------------------------------------------------------------------------
   F. Blitz Marathon Screen
   -------------------------------------------------------------------------- */
.marathon-timer-box {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(220, 38, 38, 0.2);
  border: 1px solid #DC2626;
  border-radius: 20px;
  padding: 4px 12px;
  font-family: var(--font-code);
  font-size: 16px;
  font-weight: 900;
  color: #F87171;
}

.marathon-score-box {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(245, 158, 11, 0.2);
  border: 1px solid #F59E0B;
  border-radius: 20px;
  padding: 4px 12px;
  font-family: var(--font-code);
  font-size: 15px;
  font-weight: 900;
  color: #FDE047;
}

/* --------------------------------------------------------------------------
   G. Catalog Filter Tabs & Level Grid Polish
   -------------------------------------------------------------------------- */
.catalog-filter-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.catalog-filter-btn {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  padding: 6px 14px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.catalog-filter-btn:hover {
  color: var(--text-primary);
  background: var(--bg-surface-elevated);
}

.catalog-filter-btn.active {
  background: var(--accent-level-1);
  color: #FFF;
  border-color: #38BDF8;
}

.level-card.boss-card {
  border: 2px solid #8B5CF6;
  background: linear-gradient(135deg, rgba(30, 27, 75, 0.8), rgba(15, 23, 42, 0.9));
  box-shadow: 0 4px 20px rgba(139, 92, 246, 0.35);
}

.level-card.boss-card:hover:not(.locked) {
  border-color: #FDE047;
  box-shadow: 0 8px 25px rgba(253, 224, 71, 0.4);
}
